{
  "name": "@chuvenger/svelte-stack",
  "version": "0.4.0",
  "description": "SvelteKit stack: Svelte, SvelteKit, svelte-check, Vite",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chubacca/stacks.git",
    "directory": "packages/svelte"
  },
  "exports": {
    "./tsconfig.json": "./tsconfig.json",
    "./vite": {
      "types": "./vite.config.d.ts",
      "default": "./vite.config.js"
    },
    "./svelte.config": {
      "types": "./svelte.config.d.ts",
      "default": "./svelte.config.js"
    }
  },
  "bin": {
    "link-stack-skills": "./link-skills.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@chuvenger/typescript-app-stack": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.57.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte-check": "^4.7.6",
    "@lucide/svelte": "^1.43.0",
    "vite": "^8.2.2",
    "bits-ui": "^2.19.0"
  }
}

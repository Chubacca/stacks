    "svelte": "^5.57.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.7.6",
    "@lucide/svelte": "^1.52.0",
    "vite": "^8.3.2",
    "bits-ui": "^2.19.5"
